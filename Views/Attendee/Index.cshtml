@model IEnumerable<AttendeeVisit>
@{
    ViewData["Title"] = "Monitoring";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="mb-1">Attendee Monitoring</h1><p class="text-muted mb-0">Track conference attendance and departures.</p></div>
    <a asp-action="Create" class="btn btn-primary">+ Register Attendee</a>
</div>
<form method="get" class="row g-2 mb-4">
    <div class="col-md-8"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search ticket, name, organization, or event..." /></div>
    <div class="col-auto"><button class="btn btn-outline-primary">Search</button></div>
    <div class="col-auto"><a asp-action="Index" class="btn btn-outline-secondary">Clear</a></div>
</form>
<div class="table-responsive">
<table class="table table-hover align-middle bg-white shadow-sm">
<thead class="table-primary"><tr><th>Ticket Number</th><th>Attendee</th><th>Organization</th><th>Check-In</th><th>Check-Out</th><th>Status</th><th>Actions</th></tr></thead>
<tbody>
@foreach (var item in Model)
{
<tr>
<td>@item.TicketNumber</td>
<td>@item.FirstName @item.LastName</td>
<td>@item.Organization</td>
<td>@item.CheckInTime.ToString("MMM dd, yyyy h:mm tt")</td>
<td>@(item.CheckOutTime?.ToString("MMM dd, yyyy h:mm tt") ?? "-")</td>
<td><span class="badge @(item.Status == "Present" ? "text-bg-success" : "text-bg-secondary")">@item.Status</span></td>
<td class="text-nowrap">
<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
@if (item.Status == "Present") { <a asp-action="CheckOut" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Check-Out</a> }
<form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this attendee?');"><button class="btn btn-sm btn-outline-danger">Delete</button></form>
</td>
</tr>
}
@if (!Model.Any()) { <tr><td colspan="7" class="text-center py-4 text-muted">No attendees found.</td></tr> }
</tbody></table></div>
