@model LoginDto
@{
    ViewData["Title"] = "Login";
}
<div class="row justify-content-center">
<div class="col-md-5">
<div class="card shadow-sm">
<div class="card-body p-4">
<h2 class="mb-4">Staff Login</h2>
@if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="Login" method="post">
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    <div class="mb-3"><label asp-for="Username" class="form-label"></label><input asp-for="Username" class="form-control" /><span asp-validation-for="Username" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger"></span></div>
    <button class="btn btn-primary w-100">Login</button>
</form>
<p class="mt-3 mb-0 text-center">No account? <a asp-action="Register">Register</a></p>
</div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
